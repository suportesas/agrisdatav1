# ==============================================================================
# CONFIGURAÇÕES GERAIS
# ==============================================================================
# ATENÇÃO: Copie este arquivo para .env e preencha com seus dados reais
# NUNCA commite o arquivo .env com dados sensíveis!

# Chave secreta do Django (gere uma nova em: https://djecrety.ir/)
SECRET_KEY=django-insecure-cole-uma-chave-secreta-aqui-nunca-use-em-producao

# Modo de debug (True apenas em desenvolvimento)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para browser/API (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# ==============================================================================
# BANCO DE DADOS
# ==============================================================================
# Para desenvolvimento, pode usar SQLite (padrão do Django)
# Para produção, recomenda-se PostgreSQL

# PostgreSQL (descomente para usar)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=erp_agricola
# DB_USER=postgres
# DB_PASSWORD=sua_senha_aqui
# DB_HOST=localhost
# DB_PORT=5432

# MySQL (alternativa)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=erp_agricola
# DB_USER=root
# DB_PASSWORD=sua_senha_aqui
# DB_HOST=localhost
# DB_PORT=3306

# ==============================================================================
# EMAIL (para notificações e envio de pedidos)
# ==============================================================================
# Para apenas testar sem enviar (imprime no console):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para enviar emails reais (SMTP):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail (RECOMENDADO para testes):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu.email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_aqui
DEFAULT_FROM_EMAIL=ERP Agrícola <seu.email@gmail.com>

# COMO OBTER SENHA DE APP DO GMAIL:
# 1. Ative a verificação em 2 etapas: https://myaccount.google.com/security
# 2. Gerar senha de app: https://myaccount.google.com/apppasswords
# 3. Selecione "App" como "Outro" e digite "ERP Agrícola"
# 4. Copie a senha de 16 caracteres (sem espaços)
# 5. Cole no EMAIL_HOST_PASSWORD acima

# Outlook/Hotmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu.email@outlook.com
# EMAIL_HOST_PASSWORD=sua_senha_normal
# DEFAULT_FROM_EMAIL=ERP Agrícola <seu.email@outlook.com>

# Office 365:
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu.email@empresa.com
# EMAIL_HOST_PASSWORD=sua_senha_normal
# DEFAULT_FROM_EMAIL=ERP Agrícola <seu.email@empresa.com>

# ==============================================================================
# ARQUIVOS E MÍDIA
# ==============================================================================
# URL base para arquivos estáticos
STATIC_URL=/static/
MEDIA_URL=/media/

# ==============================================================================
# TIMEZONE
# ==============================================================================
TIME_ZONE=America/Fortaleza
LANGUAGE_CODE=pt-br

# ==============================================================================
# SEGURANÇA (para produção)
# ==============================================================================
# Habilite HTTPS e cookies seguros em produção:
# SITE_DOMAIN=erp.minhaempresa.com.br
# SITE_HTTPS=True
# SECURE_SSL_REDIRECT=True
# USE_X_FORWARDED_PROTO=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax
# X_FRAME_OPTIONS=DENY
# SECURE_REFERRER_POLICY=same-origin
# SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ==============================================================================
# SUPABASE CONFIGURATION (PostgreSQL + Auth + RLS)
# ==============================================================================
# Obtenha estes valores em: https://supabase.com/dashboard

# URL do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Chaves de acesso
# - ANON_KEY: usar no frontend
# - SERVICE_ROLE_KEY: usar no backend (manter em .env, nunca enviar ao frontend)
SUPABASE_ANON_KEY=sua_chave_anonima_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# Modo de autenticação
# - 'django': Usa Django auth nativo (compatível com BD antigo)
# - 'dual': Sincroniza com Supabase (transição)
# - 'supabase': Usa apenas Supabase Auth (final)
AUTH_MODE=django

# Google OAuth (para login com Google via Supabase)
# Obtenha em: https://console.cloud.google.com/
GOOGLE_OAUTH_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=seu-client-secret-aqui

# ==============================================================================
# FEATURE FLAGS (FASE 0 - LIBERACAO GRADUAL)
# ==============================================================================
# Mantenha todas como False por padrao e ative por fase/ambiente.

FF_COMPRAS_XML_IMPORT=False
FF_ESTOQUE_QUARENTENA_BLOQUEIO=False
FF_ESTOQUE_DEVOLUCOES_FLUXO=False
FF_RASTREABILIDADE_FULL_CHAIN=False
FF_FINANCEIRO_RENEGOCIACAO=False
FF_RECEITUARIO_AGRONOMICO_V1=False
FF_ARMADOR_INTEGRACOES_EXTERNAS=False
# ==============================================================================
# CRIPTOGRAFIA DE CAMPOS SENSIVEIS (Fernet)
# ==============================================================================
# Protege tokens de API (ex: IntegraNotas) armazenados no banco de dados.
# Um dump do banco sem esta chave nao revela os tokens.
# Gere uma chave unica com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA commite a chave real. Em producao, use variavel de ambiente no servidor.
FIELD_ENCRYPTION_KEY=
