# ==============================================================================
# CONFIGURAÇÕES GERAIS
# ==============================================================================
# ATENÇÃO: Copie este arquivo para .env e preencha com seus dados reais
# NUNCA commite o arquivo .env com dados sensíveis!

# Chave secreta do Django (gere uma nova em: https://djecrety.ir/)
SECRET_KEY=django-insecure-cole-uma-chave-secreta-aqui-nunca-use-em-producao

# Modo de debug (True apenas em desenvolvimento)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# BANCO DE DADOS
# ==============================================================================
# Para desenvolvimento, pode usar SQLite (padrão do Django)
# Para produção, recomenda-se PostgreSQL

# PostgreSQL (descomente para usar)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=erp_agricola
# DB_USER=postgres
# DB_PASSWORD=sua_senha_aqui
# DB_HOST=localhost
# DB_PORT=5432

# MySQL (alternativa)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=erp_agricola
# DB_USER=root
# DB_PASSWORD=sua_senha_aqui
# DB_HOST=localhost
# DB_PORT=3306

# ==============================================================================
# EMAIL (para notificações)
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app

# ==============================================================================
# ARQUIVOS E MÍDIA
# ==============================================================================
# URL base para arquivos estáticos
STATIC_URL=/static/
MEDIA_URL=/media/

# ==============================================================================
# TIMEZONE
# ==============================================================================
TIME_ZONE=America/Fortaleza
LANGUAGE_CODE=pt-br

# ==============================================================================
# SEGURANÇA (para produção)
# ==============================================================================
# Descomente estas linhas em produção:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY