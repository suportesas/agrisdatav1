# Exemplo de variáveis de ambiente para Docker Compose

SECRET_KEY=sua-chave-secreta-aqui
DEBUG=False
ALLOWED_HOSTS=*

# Configuração do banco Supabase (PostgreSQL)
PG_NAME=postgres
PG_USER=postgres
PG_PASSWORD=sua-senha-do-supabase
PG_HOST=seu-host.supabase.co
PG_PORT=6543

# Obrigatórias quando DEBUG=False (core/settings.py valida na subida)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Outras variáveis conforme necessário
